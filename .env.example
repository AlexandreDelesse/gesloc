# Gesloc — environment variables
# Copy to .env and fill in values. Never commit .env.

# PostgreSQL
POSTGRES_PASSWORD=changeme

# Keycloak admin (used by docker-compose to set the admin account)
KEYCLOAK_ADMIN_PASSWORD=changeme

# Frontend (Vite build-time variables — must start with VITE_)
# In dev (docker-compose), these are fixed — no need to change:
VITE_API_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=gesloc
VITE_KEYCLOAK_CLIENT_ID=gesloc-frontend
