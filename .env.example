# Gesloc — environment variables
# Copy to .env and fill in values. Never commit .env.

# PostgreSQL
POSTGRES_PASSWORD=changeme

# Keycloak
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=gesloc
KEYCLOAK_CLIENT_ID=gesloc-frontend
KEYCLOAK_ISSUER=https://auth.example.com/realms/gesloc

# Frontend (Vite build-time variables — must start with VITE_)
VITE_API_URL=http://localhost:8080
VITE_KEYCLOAK_URL=https://auth.example.com
VITE_KEYCLOAK_REALM=gesloc
VITE_KEYCLOAK_CLIENT_ID=gesloc-frontend
